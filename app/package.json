{
  "name": "hdd",
  "version": "0.0.1",
  "private": true,
  "description": "HDD - Fairy desktop terminal (Electron, DeepSeek API)",
  "main": "main.js",
  "scripts": {
    "prep": "node scripts/prep.cjs",
    "icon": "node scripts/icon.cjs",
    "test:store": "node tests/store.test.cjs",
    "test:conversation": "node tests/conversation.test.cjs",
    "test:ui": "node scripts/prep.cjs && node tests/renderer.test.cjs && node tests/scroll-pin.test.cjs",
    "start": "npm run prep && electron .",
    "dev": "node scripts/dev.cjs",
    "dev:fresh": "node scripts/dev.cjs --fresh",
    "inspect": "node scripts/inspect.cjs",
    "inspect:dev": "node scripts/inspect.cjs --dev",
    "dist": "npm run prep && node scripts/icon.cjs && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "^30.0.1"
  },
  "build": {
    "appId": "com.hdd.app",
    "productName": "HDD",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build-res"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "config.json",
      "www/**/*"
    ],
    "win": {
      "icon": "build-res/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "HDD-${version}.${ext}"
    },
    "compression": "normal"
  }
}
